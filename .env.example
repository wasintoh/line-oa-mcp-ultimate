# LINE MCP Server — Environment Variables

# REQUIRED for single-OA mode:
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here

# OPTIONAL (v2.0) — LINE Shopping (MyShop Open API) key.
# Set this to enable the 14 LINE Shopping tools (products, inventory, orders,
# settlement, checkout link). Without it, the server runs messaging-only.
# Get it from oaplus.line.biz → Settings → API keys (Admin role).
# In multi-OA mode, put "myshop_api_key" per OA in the config file instead.
LINE_MYSHOP_API_KEY=your_myshop_api_key_here

# OPTIONAL — path to multi-OA config file (default: ~/.line-mcp/config.json)
# LINE_MCP_CONFIG=/path/to/config.json

# OPTIONAL — override the default OA when multi-OA config is used
# LINE_MCP_DEFAULT_OA=main

# OPTIONAL — transport selection. 'stdio' (default) or 'http'.
# Use 'http' to expose a Streamable HTTP endpoint for Claude Cowork's
# "Add custom connector" UI (which accepts only remote URLs).
# MCP_TRANSPORT=http
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=3000
# MCP_HTTP_PATH=/mcp

# OPTIONAL — HTTP transport authentication (v2.1).
# When set, every request to the MCP path must send
#   Authorization: Bearer <MCP_HTTP_TOKEN>
# REQUIRED whenever MCP_HTTP_HOST is anything other than 127.0.0.1/::1/localhost
# (the server refuses to start on a public bind without it).
# MCP_HTTP_TOKEN=generate_a_long_random_string_here
